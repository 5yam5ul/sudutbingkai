# Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Mayar.id Payment Gateway Credentials
# Ambil dari: https://dashboard.mayar.id/integration/api-keys
MAYAR_API_KEY=your-mayar-api-key

# Webhook Token dari Pengaturan Webhook Mayar (URL Webhook: https://domain-anda.com/api/payment/webhook)
MAYAR_WEBHOOK_TOKEN=your-mayar-webhook-secret-token
