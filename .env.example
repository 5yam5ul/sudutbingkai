# Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only key to bypass RLS for administrative mutations (keep private!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cryptographic Session Integrity Secret (Server-Only, min 32 chars)
AUTH_SECRET=your-random-32-character-or-longer-secret-key

# Mayar.id Payment Gateway Credentials
# Ambil dari: https://dashboard.mayar.id/integration/api-keys
MAYAR_API_KEY=your-mayar-api-key

# Webhook Token dari Pengaturan Webhook Mayar (URL Webhook: https://domain-anda.com/api/payment/webhook)
MAYAR_WEBHOOK_TOKEN=your-mayar-webhook-secret-token

# Google Drive API Key for Proofing Proxy (Optional)
GOOGLE_DRIVE_API_KEY=your-google-drive-api-key

# Google Identity Services (GIS) OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
